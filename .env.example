# Copy to .env and adjust. Loaded by bgcscape.config.Settings (pydantic-settings).

# Postgres (recommended, matches docker-compose.yml defaults):
BGCSCAPE_DATABASE_URL=postgresql+psycopg://bgcscape:bgcscape@localhost:5432/bgcscape

# SQLite (zero-setup local/dev alternative — fine for exploring the CLI, not
# recommended once real reference-data volumes show up):
# BGCSCAPE_DATABASE_URL=sqlite+pysqlite:///./bgcscape_dev.db

BGCSCAPE_ENVIRONMENT=development
