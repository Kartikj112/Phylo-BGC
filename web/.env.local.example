# Copy to .env.local. The API base URL the browser fetches from directly
# (client-side rendered), so it must be NEXT_PUBLIC_ to be exposed to the
# browser bundle — see src/lib/api-client.ts.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# The site's own public origin (no trailing slash), e.g. https://phylo-bgc.vercel.app
#
# Distinct from NEXT_PUBLIC_API_URL above: that is where the API lives, this is
# where THIS site lives. It is what makes og:image absolute (a relative one is
# dropped by most crawlers, so the share card silently disappears), and what
# sitemap.xml and robots.txt announce.
#
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL if unset, so a
# production deploy still emits its real hostname. Set it explicitly for any
# other host, or the sitemap will advertise http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
