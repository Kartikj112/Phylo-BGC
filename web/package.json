{
  "name": "phylo-bgc-web",
  "version": "0.1.0",
  "private": true,
  "description": "Phylo-BGC frontend: taxonomy tree + BGC overlay explorer. Consumes the engine's read-only API (engine/src/bgcscape/api) \u2014 contains no biological logic of its own, per ARCHITECTURE.md's separation of concerns.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate-api-types": "openapi-typescript ../engine/openapi.json -o src/lib/api-schema.generated.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "lucide-react": "^0.383.0",
    "next": "^16.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/d3": "^7.4.3",
    "@types/d3-sankey": "^0.12.4",
    "@types/node": "^20.14.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.3.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vitest": "^4.1.11"
  }
}