# Keep the build context small and never ship stray local databases — but
# DO ship the one pre-built dataset the image serves.
.git
.gitignore
**/__pycache__
**/*.pyc
# `**/` matters: a bare `*.db` only matches the context root, and let
# data/local.db (the start scripts' working copy, uploads and all) into
# the image.
**/*.db
**/*.db-*
**/*.sqlite3
!gtdb_mibig_bundled.db
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov
.venv
venv
dist
build
*.egg-info
openapi.json
.env
