htmlcov/
node_modules/
.DS_Store

# Next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Local env files (the *.example templates stay tracked). NEXT_PUBLIC_API_URL
# is set per-environment: web/.env.local for local dev, the Vercel project
# settings for the deployment.
.env*.local

# Regeneratable API contract snapshot — the generated TS types
# (web/src/lib/api-schema.generated.ts) ARE committed; this raw dump
# isn't, see `bgcscape dump-openapi-schema` in cli/main.py.
engine/openapi.json

# Playwright browser-test output (traces, screenshots, HTML report). The
# specs in web/e2e/ are checked in; their run artifacts are not.
web/test-results/
web/playwright-report/

# The shipped corpus is tracked on purpose, despite the *.db rule above: the
# API serves it as-is. Other local databases (real.db, *.backup.db) stay out.
!engine/gtdb_mibig_bundled.db

# Hypothesis example database (property-based test cache)
.hypothesis/

# Any other local env file; only the committed *.example templates are tracked
.env.*
!.env*.example

# Logs and caches
*.log
npm-debug.log*
.eslintcache
coverage/

# Deployment CLI state
.vercel/
.fly/

# Editor and OS clutter
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
